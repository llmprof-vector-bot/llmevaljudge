MYSQL_ROOT_PASSWORD=changeme
TZ=Europe/Berlin
WEB_PORT=80
DB_PORT=3306
PHPMYADMIN_PORT=8081
DEV_SERVER_PORT=8080
SEARCH_PORT=8888

# Optional: Brave Search API key for the braveapi SearXNG engine (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# Evaluation service (judge_eval) call handling in the messenger workers:
# EVAL_TIMEOUT    - idle timeout per evaluation attempt; the eval service sends no
#                   bytes until done, so it is effectively the wall-clock budget
#                   per attempt. A stalled/parked gateway request is cut here.
# EVAL_MAX_RETRIES - attempts per item (prompt/metric/model/run) before the
#                   attempt is recorded as a benchmark error.
EVAL_TIMEOUT=300
EVAL_MAX_RETRIES=5